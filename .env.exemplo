# Copie para `.env` (que NÃO vai para o Git) e preencha. Ver kb/setup-meta.md.
# No GitHub Actions estes valores entram como secrets, não como arquivo.

# Token de acesso de longa duração da Meta (dura ~60 dias)
IG_TOKEN=

# Id da conta do Instagram na Graph API (não é o @, é um número)
IG_USER_ID=

# Raiz pública de onde a Meta vai buscar a imagem.
# Ex.: https://raw.githubusercontent.com/<usuario>/<repositorio>/main
HOSPEDAGEM_BASE=

# Versão da Graph API. A Meta descontinua versão antiga com regularidade.
GRAPH_VERSION=v21.0
